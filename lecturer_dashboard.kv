<LecturerDashboard>:
    canvas.before:
        Color:
            rgba: app.background_color
        Rectangle:
            pos: self.pos
            size: self.size
    orientation: 'vertical'
    padding: 8
    spacing: 8

    BoxLayout:
        size_hint_y: None
        height: '40dp'
        spacing: 8
        Label:
            text: '[b]Lecturer Dashboard[/b]'
            markup: True
            color: 1,1,1,1
            halign: 'left'
            valign: 'middle'
            text_size: self.size
        TextInput:
            id: course_code
            hint_text: 'Course code (e.g., CS101)'
            size_hint_x: None
            width: '140dp'
        Button:
            text: 'Load Course'
            size_hint_x: None
            width: '100dp'
            on_release: root.load_course(course_code.text)
        Button:
            text: 'Logout'
            size_hint_x: None
            width: '90dp'
            on_release: root.logout()

    Label:
        id: info
        text: ''
        size_hint_y: None
        height: '24dp'

    ScrollView:
        GridLayout:
            id: students_box
            cols: 1
            size_hint_y: None
            height: self.minimum_height
            spacing: 8
            row_default_height: '90dp'
            row_force_default: False
