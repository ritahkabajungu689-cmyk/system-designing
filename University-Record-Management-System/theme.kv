<Button>:
    background_normal: ''
    background_color: app.secondary_color
    color: 1, 1, 1, 1
    markup: True
    font_name: 'Roboto-Bold.ttf'

<Label>:
    color: app.text_color

<Spinner>:
    color: app.text_color

<TextInput>:
    foreground_color: app.text_color
    background_color: app.background_color
