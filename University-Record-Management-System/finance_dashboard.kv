<FinanceDashboard>:
    canvas.before:
        Color:
            rgba: app.background_color
        Rectangle:
            pos: self.pos
            size: self.size
    orientation: 'vertical'
    padding: 8
    spacing: 8

    BoxLayout:
        size_hint_y: None
        height: '40dp'
        spacing: 8
        Label:
            text: '[b]Finance Dashboard[/b]'
            markup: True
            color: 1,1,1,1
            halign: 'left'
            valign: 'middle'
            text_size: self.size
        Button:
            text: 'Filter Balances'
            size_hint_x: None
            width: '120dp'
            on_release: root.filter_balances()
        Button:
            text: 'Refresh'
            size_hint_x: None
            width: '90dp'
            on_release: root.refresh_students()
        Button:
            text: 'Logout'
            size_hint_x: None
            width: '90dp'
            on_release: root.logout()

    Label:
        text: 'Students Tuition'
        size_hint_y: None
        height: '24dp'

    ScrollView:
        GridLayout:
            id: students_box
            cols: 1
            size_hint_y: None
            height: self.minimum_height
            spacing: 6
            row_default_height: '40dp'
            row_force_default: True
